    {
      "path": "Linkage",
      "min": 0,
      "max": "*",
      "type": [],
      "isModifier": false,
      "isModifierReason": null,
      "mustSupport": null,
      "short": "Links records for 'same' item",
      "definition": "Identifies two or more records (resource instances) that refer to the same real-world \"occurrence\".",
      "binding": null
    },
    {
      "path": "Linkage.id",
      "min": 0,
      "max": "1",
      "type": [
        {
          "code": "http://hl7.org/fhirpath/System.String"
        }
      ],
      "isModifier": false,
      "isModifierReason": null,
      "mustSupport": null,
      "short": "Logical id of this artifact",
      "definition": "The logical id of the resource, as used in the URL for the resource. Once assigned, this value never changes.",
      "binding": null
    },
    {
      "path": "Linkage.meta",
      "min": 0,
      "max": "1",
      "type": [
        {
          "code": "Meta"
        }
      ],
      "isModifier": false,
      "isModifierReason": null,
      "mustSupport": null,
      "short": "Metadata about the resource",
      "definition": "The metadata about the resource. This is content that is maintained by the infrastructure. Changes to the content might not always be associated with version changes to the resource.",
      "binding": null
    },
    {
      "path": "Linkage.implicitRules",
      "min": 0,
      "max": "1",
      "type": [
        {
          "code": "uri"
        }
      ],
      "isModifier": true,
      "isModifierReason": "This element is labeled as a modifier because the implicit rules may provide additional knowledge about the resource that modifies it's meaning or interpretation",
      "mustSupport": null,
      "short": "A set of rules under which this content was created",
      "definition": "A reference to a set of rules that were followed when the resource was constructed, and which must be understood when processing the content. Often, this is a reference to an implementation guide that defines the special rules along with other profiles etc.",
      "binding": null
    },
    {
      "path": "Linkage.language",
      "min": 0,
      "max": "1",
      "type": [
        {
          "code": "code"
        }
      ],
      "isModifier": false,
      "isModifierReason": null,
      "mustSupport": null,
      "short": "Language of the resource content",
      "definition": "The base language in which the resource is written.",
      "binding": {
        "valueSet": "http://hl7.org/fhir/ValueSet/languages",
        "strength": "preferred",
        "description": "A human language."
      }
    },
    {
      "path": "Linkage.text",
      "min": 0,
      "max": "1",
      "type": [
        {
          "code": "Narrative"
        }
      ],
      "isModifier": false,
      "isModifierReason": null,
      "mustSupport": null,
      "short": "Text summary of the resource, for human interpretation",
      "definition": "A human-readable narrative that contains a summary of the resource and can be used to represent the content of the resource to a human. The narrative need not encode all the structured data, but is required to contain sufficient detail to make it \"clinically safe\" for a human to just read the narrative. Resource definitions may define what content should be represented in the narrative to ensure clinical safety.",
      "binding": null
    },
    {
      "path": "Linkage.contained",
      "min": 0,
      "max": "*",
      "type": [
        {
          "code": "Resource"
        }
      ],
      "isModifier": false,
      "isModifierReason": null,
      "mustSupport": null,
      "short": "Contained, inline Resources",
      "definition": "These resources do not have an independent existence apart from the resource that contains them - they cannot be identified independently, and nor can they have their own independent transaction scope.",
      "binding": null
    },
    {
      "path": "Linkage.extension",
      "min": 0,
      "max": "*",
